# SECTION 12: SENIOR CONCERN INVESTIGATION
# Directly investigates whether Dataset 2 is
# truly spatially diverse or effectively
# a replicated single-point dataset [1][3]
# ============================================================

def investigate_spatial_replication(df, name):
    """
    Tests whether observations across locations
    at the same timestep are identical or near-
    identical, which would indicate the dataset
    is not truly spatial.

    Four specific tests:
    1. Are SMAP values identical across nodes?
    2. Do weather values vary across lat/lon?
    3. Does topography vary across locations?
    4. Are site labels meaningful spatial groups?
    """
    print(f"\n{'='*65}")
    print(f"  SPATIAL REPLICATION INVESTIGATION")
    print(f"  {name}")
    print(f"{'='*65}")

    # Test A: SMAP node uniqueness
    if ('smap_node_x' in df.columns and
            'smap_node_y' in df.columns):
        unique_nodes = (
            df[['smap_node_x', 'smap_node_y']]
            .drop_duplicates())
        print(f"\n  A. SMAP Node Uniqueness:")
        print(f"     Unique nodes: "
              f"{len(unique_nodes)}")
        print(f"     Node X range: "
              f"{int(df['smap_node_x'].min())} "
              f"to "
              f"{int(df['smap_node_x'].max())}")
        print(f"     Node Y range: "
              f"{int(df['smap_node_y'].min())} "
              f"to "
              f"{int(df['smap_node_y'].max())}")

        # Do SMAP temperature values differ
        # between nodes at same time?
        if ('Soil_Temp_L1' in df.columns and
                'time_utc' in df.columns):
            sample_t = (
                df['time_utc'].dropna()
                .sort_values()
                .iloc[len(df) // 2])
            at_t = df[
                df['time_utc'] == sample_t]

            if len(at_t) > 1:
                l1_vals = (
                    at_t['Soil_Temp_L1']
                    .dropna())
                print(f"\n     Soil_Temp_L1 "
                      f"at {sample_t}:")
                print(f"     Records : "
                      f"{len(l1_vals)}")
                print(f"     Min     : "
                      f"{l1_vals.min():.4f}")
                print(f"     Max     : "
                      f"{l1_vals.max():.4f}")
                print(f"     Std     : "
                      f"{l1_vals.std():.4f}")
                if l1_vals.std() > 0.01:
                    print(f"     RESULT  : "
                          f"VALUES DIFFER ACROSS "
                          f"NODES -- dataset is "
                          f"spatially diverse")
                else:
                    print(f"     RESULT  : "
                          f"VALUES ARE IDENTICAL "
                          f"-- dataset may be "
                          f"replicated single-point")

    # Test B: Weather variable variation
    print(f"\n  B. Weather Variable Variation "
          f"Across Locations:")
    weather_cols = [
        'temperature_2m',
        'precipitation',
        'snow_depth_weather',
    ]
    for col in weather_cols:
        if col not in df.columns:
            continue
        if 'time_utc' not in df.columns:
            continue
        sample_t = (
            df['time_utc'].dropna()
            .sort_values()
            .iloc[len(df) // 2])
        at_t = df[df['time_utc'] == sample_t]
        vals = at_t[col].dropna()
        if len(vals) < 2:
            continue
        std_val = vals.std()
        verdict = (
            "VARIES" if std_val > 0.001
            else "CONSTANT")
        print(f"     {col:<30}: "
              f"std={std_val:.4f} "
              f"-- {verdict}")

    # Test C: Topography variation
    print(f"\n  C. Topography Variation "
          f"Across Locations:")
    topo_cols = [
        'elevation_m',
        'elev_roughness_m',
        'slope_deg',
    ]
    for col in topo_cols:
        if col not in df.columns:
            continue
        unique_vals = df[col].dropna().nunique()
        std_val     = df[col].dropna().std()
        verdict = (
            "VARIES SPATIALLY"
            if unique_vals > 10
            else "LIMITED VARIATION")
        print(f"     {col:<30}: "
              f"{unique_vals} unique values "
              f"std={std_val:.2f} "
              f"-- {verdict}")

    # Test D: Site label analysis
    print(f"\n  D. Site Label Analysis:")
    if 'Site' in df.columns:
        sites = df['Site'].unique()
        print(f"     Unique sites: {len(sites)}")
        print(f"     Site names  : {list(sites)}")

        # Do sites have different coordinates?
        if ('Latitude' in df.columns and
                'Longitude' in df.columns):
            site_coords = (
                df.groupby('Site')[
                    ['Latitude', 'Longitude']]
                .agg(['min', 'max', 'nunique']))
            print(f"\n     Site coordinate ranges:")
            for site in sites:
                site_data = df[
                    df['Site'] == site]
                lat_range = (
                    site_data['Latitude'].max()
                    - site_data['Latitude'].min())
                lon_range = (
                    site_data['Longitude'].max()
                    - site_data['Longitude'].min())
                n_unique  = len(
                    site_data[
                        ['Latitude','Longitude']]
                    .drop_duplicates())
                print(f"     {site:<20}: "
                      f"lat_span={lat_range:.3f} "
                      f"lon_span={lon_range:.3f} "
                      f"unique_locs={n_unique}")

    # Overall assessment
    print(f"\n  OVERALL SPATIAL ASSESSMENT:")
    print(f"  Based on the tests above, "
          f"the spatial structure of {name}")
    print(f"  should be interpreted as follows:")
    print(f"  - If SMAP values differ across "
          f"nodes: dataset is truly spatial")
    print(f"  - If topography varies: meaningful "
          f"spatial heterogeneity exists")
    print(f"  - If weather is constant at a "
          f"given time: weather is gridded")
    print(f"    product, not truly spatial")
    print(f"  - Sites represent ecosystem types,")
    print(f"    not geographic regions")


