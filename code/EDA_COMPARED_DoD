def parse_and_describe_time(df, name,
                              time_candidates):
    """
    Identify and parse datetime columns.
    Report temporal coverage and resolution.
    """
    print(f"\n{'='*65}")
    print(f"  TEMPORAL COVERAGE: {name}")
    print(f"{'='*65}")

    for col in time_candidates:
        if col not in df.columns:
            continue
        try:
            dt_col = pd.to_datetime(
                df[col], utc=True,
                errors='coerce')
            n_valid  = dt_col.notna().sum()
            n_null   = dt_col.isna().sum()
            dt_min   = dt_col.min()
            dt_max   = dt_col.max()
            n_days   = (dt_max - dt_min).days
            n_unique = dt_col.nunique()

            print(f"\n  Column    : {col}")
            print(f"  Valid     : {n_valid:,}")
            print(f"  Null      : {n_null:,}")
            print(f"  Start     : {dt_min}")
            print(f"  End       : {dt_max}")
            print(f"  Span      : {n_days} days "
                  f"({n_days/365.25:.1f} years)")
            print(f"  Unique ts : {n_unique:,}")

            # Detect temporal resolution
            dt_sorted = dt_col.dropna().sort_values()
            if len(dt_sorted) > 1:
                diffs = dt_sorted.diff().dropna()
                mode_diff = (diffs
                             .value_counts()
                             .index[0])
                print(f"  Resolution: {mode_diff}")

            # Years present
            years = sorted(
                dt_col.dt.year.dropna()
                .astype(int).unique())
            print(f"  Years     : {years}")

        except Exception as e:
            print(f"  Could not parse {col}: {e}")


