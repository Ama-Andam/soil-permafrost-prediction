def freeze_thaw_analysis(df, name,
                          temp_col,
                          time_col):
    """
    Freeze-thaw cycle analysis.
    Critical for Alaska permafrost research.
    Reports frozen days per year, transition
    frequency, and seasonal freeze onset.
    """
    print(f"\n{'='*65}")
    print(f"  FREEZE-THAW ANALYSIS: {name}")
    print(f"{'='*65}")

    if (temp_col not in df.columns or
            time_col not in df.columns):
        print(f"  Required columns not found.")
        print(f"  temp_col: {temp_col}")
        print(f"  time_col: {time_col}")
        return None

    df_ft = df[[time_col, temp_col]].copy()
    df_ft[time_col] = pd.to_datetime(
        df_ft[time_col], errors='coerce')
    df_ft = df_ft.dropna()
    df_ft['year']    = df_ft[time_col].dt.year
    df_ft['month']   = df_ft[time_col].dt.month
    df_ft['is_frozen']= (
        df_ft[temp_col] < 0).astype(int)

    # Frozen fraction per year
    print(f"\n  Frozen fraction per year:")
    print(f"  {'Year':<8} {'Frozen%':>10} "
          f"{'Mean Temp':>12} "
          f"{'Min Temp':>10} "
          f"{'Max Temp':>10}")
    print("  " + "-" * 52)

    annual = df_ft.groupby('year').agg(
        frozen_pct  = (
            'is_frozen', 'mean'),
        mean_temp   = (temp_col, 'mean'),
        min_temp    = (temp_col, 'min'),
        max_temp    = (temp_col, 'max'),
        n_records   = (temp_col, 'count'),
    ).reset_index()

    for _, row in annual.iterrows():
        print(
            f"  {int(row['year']):<8} "
            f"{row['frozen_pct']*100:>9.1f}% "
            f"{row['mean_temp']:>12.3f} "
            f"{row['min_temp']:>10.3f} "
            f"{row['max_temp']:>10.3f}")

    # Freeze onset by month
    print(f"\n  Monthly frozen fraction "
          f"(all years combined):")
    print(f"  {'Month':<8} {'Frozen%':>10} "
          f"{'Mean Temp':>12}")
    print("  " + "-" * 32)

    monthly = df_ft.groupby('month').agg(
        frozen_pct = ('is_frozen', 'mean'),
        mean_temp  = (temp_col, 'mean'),
    ).reset_index()

    month_names = {
        1:'Jan', 2:'Feb', 3:'Mar',
        4:'Apr', 5:'May', 6:'Jun',
        7:'Jul', 8:'Aug', 9:'Sep',
        10:'Oct', 11:'Nov', 12:'Dec',
    }
    for _, row in monthly.iterrows():
        mname = month_names.get(
            int(row['month']), str(row['month']))
        print(
            f"  {mname:<8} "
            f"{row['frozen_pct']*100:>9.1f}% "
            f"{row['mean_temp']:>12.3f}")

    # Transition detection
    # Count freeze/thaw events per year
    print(f"\n  Freeze-thaw transition count "
          f"per year:")
    df_ft_sorted = df_ft.sort_values(time_col)
    df_ft_sorted['state_change'] = (
        df_ft_sorted['is_frozen'].diff().abs())

    transitions = (
        df_ft_sorted
        .groupby('year')['state_change']
        .sum()
        .reset_index())

    for _, row in transitions.iterrows():
        print(f"  {int(row['year']):<8}: "
              f"{int(row['state_change']):>6} "
              f"transitions")

    return annual


