def missing_value_analysis(df, name):
    """
    Detailed missing value analysis.
    Reports counts, percentages, and patterns.
    Identifies columns that may be unusable.
    """
    print(f"\n{'='*65}")
    print(f"  MISSING VALUE ANALYSIS: {name}")
    print(f"{'='*65}")

    total_cells = df.shape[0] * df.shape[1]
    total_miss  = df.isna().sum().sum()
    pct_overall = 100 * total_miss / total_cells

    print(f"\n  Total cells   : {total_cells:,}")
    print(f"  Missing cells : {total_miss:,}")
    print(f"  Overall pct   : {pct_overall:.2f}%")

    # Per column
    miss_df = pd.DataFrame({
        'column'       : df.columns,
        'missing_n'    : df.isna().sum().values,
        'missing_pct'  : (
            df.isna().mean() * 100).values,
        'dtype'        : df.dtypes.values,
    }).sort_values(
        'missing_pct', ascending=False)

    print(f"\n  {'Column':<35} "
          f"{'Missing N':>10} "
          f"{'Missing%':>10} "
          f"{'Status':>15}")
    print("  " + "-" * 72)

    for _, row in miss_df.iterrows():
        pct    = row['missing_pct']
        status = (
            "CRITICAL (>50%)"
            if pct > 50
            else "HIGH (>20%)"
            if pct > 20
            else "MODERATE (>5%)"
            if pct > 5
            else "LOW (<5%)"
            if pct > 0
            else "COMPLETE")
        print(f"  {row['column']:<35} "
              f"{int(row['missing_n']):>10,} "
              f"{pct:>9.2f}% "
              f"{status:>15}")

    # Rows with any missing value
    rows_with_miss = df.isna().any(axis=1).sum()
    print(f"\n  Rows with any missing: "
          f"{rows_with_miss:,} "
          f"({100*rows_with_miss/len(df):.2f}%)")
    print(f"  Rows fully complete  : "
          f"{len(df) - rows_with_miss:,} "
          f"({100*(len(df)-rows_with_miss)/len(df):.2f}%)")


