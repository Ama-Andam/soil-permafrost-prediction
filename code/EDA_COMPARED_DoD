def assess_spatial_adequacy(df, name):
    """
    Comprehensive spatial adequacy assessment.
    Addresses whether a dataset has meaningful
    spatial variation or is effectively single-point.

    Tests performed:
    1. Number of unique spatial locations
    2. Spatial variation of target variables
       at the same timestep
    3. Correlation between distance and
       variable difference
    4. Intra-location vs inter-location variance
    5. Effective number of independent locations
    """
    print(f"\n{'='*65}")
    print(f"  SPATIAL ADEQUACY ASSESSMENT: {name}")
    print(f"{'='*65}")

    lat_col = next(
        (c for c in df.columns
         if 'lat' in c.lower()), None)
    lon_col = next(
        (c for c in df.columns
         if 'lon' in c.lower()), None)

    if lat_col is None or lon_col is None:
        print("  No latitude/longitude columns.")
        print("  Cannot assess spatial adequacy.")
        return

    # Test 1: Unique locations
    unique_locs = (
        df[[lat_col, lon_col]]
        .dropna()
        .drop_duplicates())
    n_locs = len(unique_locs)
    print(f"\n  Test 1: Unique locations")
    print(f"    Count    : {n_locs:,}")
    print(f"    Verdict  : "
          + ("ADEQUATE (>10 unique)"
             if n_locs > 10
             else "INSUFFICIENT (<= 10)"))

    # Test 2: Spatial variation at same time
    print(f"\n  Test 2: Spatial variation "
          f"at same timestep")

    time_col = next(
        (c for c in df.columns
         if 'time' in c.lower()), None)

    if time_col is not None:
        sample_t = (
            df[time_col].dropna()
            .sort_values()
            .iloc[len(df) // 2])
        same_t = df[df[time_col] == sample_t]
    # Test 2 continued: Spatial variation
    print(f"\n  Test 2: Spatial variation "
          f"at same timestep")
    print(f"    Sample time: {sample_t}")
    print(f"    Records    : {len(same_t)}")

    temp_cols = [
        c for c in df.columns
        if 'temp' in c.lower()
        or 'soil' in c.lower()
        or 'sm_' in c.lower()
    ]
    temp_cols = temp_cols[:6]

    for col in temp_cols:
        if col not in same_t.columns:
            continue
        vals = same_t[col].dropna()
        if len(vals) < 2:
            continue
        std_val  = vals.std()
        mean_val = vals.mean()
        cv = (abs(std_val / mean_val) * 100
              if mean_val != 0 else 0)
        verdict = (
            "MEANINGFUL SPATIAL VARIATION"
            if std_val > 0.01
            else "NEGLIGIBLE VARIATION")
        print(f"    {col:<35}: "
              f"std={std_val:.4f} "
              f"cv={cv:.2f}% "
              f"-- {verdict}")

    # Test 3: Variance decomposition
    # Inter-location vs intra-location
    print(f"\n  Test 3: Variance decomposition")
    print(f"    (inter-location vs "
          f"intra-location)")

    if (lat_col in df.columns and
            time_col is not None):
        for col in temp_cols[:3]:
            if col not in df.columns:
                continue
            try:
                # Total variance
                total_var = df[col].var()

                # Mean per location
                loc_means = (
                    df.groupby(
                        [lat_col, lon_col])[col]
                    .mean())
                inter_var = loc_means.var()

                # Intra-location variance
                intra_var = (
                    df.groupby(
                        [lat_col, lon_col])[col]
                    .var().mean())

                pct_inter = (
                    100 * inter_var /
                    (total_var + 1e-10))
                pct_intra = (
                    100 * intra_var /
                    (total_var + 1e-10))

                print(
                    f"    {col:<30}: "
                    f"inter={pct_inter:.1f}% "
                    f"intra={pct_intra:.1f}%")
                if pct_inter > 10:
                    print(
                        f"      Meaningful spatial "
                        f"structure detected")
                else:
                    print(
                        f"      Low spatial "
                        f"differentiation")
            except Exception as e:
                print(
                    f"    {col}: "
                    f"could not compute ({e})")

    # Test 4: Effective spatial resolution
    print(f"\n  Test 4: Effective spatial "
          f"resolution")
    try:
        unique_locs_test = (
            df[[lat_col, lon_col]]
            .dropna()
            .drop_duplicates())
        lat_range = (
            unique_locs_test[lat_col].max()
            - unique_locs_test[lat_col].min())
        lon_range = (
            unique_locs_test[lon_col].max()
            - unique_locs_test[lon_col].min())
        area_deg2 = lat_range * lon_range
        n_locs    = len(unique_locs_test)
        density   = (n_locs / area_deg2
                     if area_deg2 > 0 else 0)

        print(f"    Coverage area  : "
              f"{lat_range:.3f} x "
              f"{lon_range:.3f} deg")
        print(f"    Location count : {n_locs}")
        print(f"    Density        : "
              f"{density:.1f} locs/deg2")
    except Exception as e:
        print(f"    Could not compute: {e}")

    # Summary verdict
    print(f"\n  SPATIAL ADEQUACY VERDICT:")
    if n_locs >= 50:
        print(f"    ADEQUATE: {n_locs} unique "
              f"locations provide sufficient "
              f"spatial coverage for field "
              f"prediction")
    elif n_locs >= 10:
        print(f"    MARGINAL: {n_locs} unique "
              f"locations provide limited "
              f"spatial coverage")
    else:
        print(f"    INSUFFICIENT: {n_locs} "
              f"unique locations -- effectively "
              f"a single-point dataset")


