def full_descriptive_stats(df, name,
                            numeric_cols=None):
    """
    Compute and print full descriptive statistics
    for all numeric columns.
    Reports: count, mean, std, min, quartiles,
    max, skewness, kurtosis, percent below zero.
    """
    print(f"\n{'='*70}")
    print(f"  DESCRIPTIVE STATISTICS: {name}")
    print(f"{'='*70}")

    if numeric_cols is None:
        numeric_cols = (
            df.select_dtypes(
                include=[np.number])
            .columns.tolist())

    # Remove index-like columns
    numeric_cols = [
        c for c in numeric_cols
        if df[c].nunique() > 5]

    desc = df[numeric_cols].describe().T
    desc['skewness']   = (
        df[numeric_cols].skew())
    desc['kurtosis']   = (
        df[numeric_cols].kurtosis())
    desc['pct_below_0']= (
        (df[numeric_cols] < 0).mean() * 100)
    desc['pct_missing']= (
        df[numeric_cols].isna().mean() * 100)

    print(desc.round(4).to_string())

    return desc


