def full_column_inventory(df, name):
    """
    Print a complete column inventory for a dataset.
    Reports: column name, dtype, missing count,
    missing percent, unique count, min, max.
    """
    print(f"\n{'='*70}")
    print(f"  COLUMN INVENTORY: {name}")
    print(f"  Total rows    : {len(df):,}")
    print(f"  Total columns : {df.shape[1]}")
    print(f"{'='*70}")
    print(
        f"  {'Column':<35} {'dtype':<12} "
        f"{'NaN N':>8} {'NaN%':>7} "
        f"{'Unique':>8}")
    print("  " + "-" * 72)

    for col in df.columns:
        dtype   = str(df[col].dtype)
        n_nan   = int(df[col].isna().sum())
        pct_nan = round(100 * n_nan / len(df), 2)
        n_uniq  = int(df[col].nunique())
        flag    = " WARNING" \
            if pct_nan > 20 else ""
        print(
            f"  {col:<35} {dtype:<12} "
            f"{n_nan:>8,} {pct_nan:>6.2f}% "
            f"{n_uniq:>8,}{flag}")

    # Identify column groups
    spatial_candidates = [
        c for c in df.columns
        if any(k in c.lower() for k in
               ['lat', 'lon', 'node',
                'x', 'y', 'coord',
                'location', 'site',
                'grid', 'spatial'])
    ]
    temporal_candidates = [
        c for c in df.columns
        if any(k in c.lower() for k in
               ['time', 'date', 'year',
                'month', 'hour', 'day',
                'timestamp'])
    ]
    temp_candidates = [
        c for c in df.columns
        if any(k in c.lower() for k in
               ['temp', 'soil_temp',
                'temperature'])
    ]
    moist_candidates = [
        c for c in df.columns
        if any(k in c.lower() for k in
               ['moist', 'moisture',
                'sm_', 'sm_surface',
                'rootzone'])
    ]

    print(f"\n  DETECTED COLUMN GROUPS:")
    print(f"  Spatial    ({len(spatial_candidates)}): "
          f"{spatial_candidates}")
    print(f"  Temporal   ({len(temporal_candidates)}): "
          f"{temporal_candidates}")
    print(f"  Temperature({len(temp_candidates)}): "
          f"{temp_candidates}")
    print(f"  Moisture   ({len(moist_candidates)}): "
          f"{moist_candidates}")

    return {
        'spatial'    : spatial_candidates,
        'temporal'   : temporal_candidates,
        'temperature': temp_candidates,
        'moisture'   : moist_candidates,
    }


