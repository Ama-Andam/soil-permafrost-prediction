def analyse_spatial_coverage(df, name,
                               spatial_cols):
    """
    Full spatial coverage analysis.
    Reports: unique locations, coordinate ranges,
    grid density, spatial resolution.
    """
    print(f"\n{'='*65}")
    print(f"  SPATIAL COVERAGE ANALYSIS: {name}")
    print(f"{'='*65}")

    # Latitude and Longitude
    lat_cols = [
        c for c in spatial_cols
        if 'lat' in c.lower()
        and c in df.columns]
    lon_cols = [
        c for c in spatial_cols
        if 'lon' in c.lower()
        and c in df.columns]

    if lat_cols and lon_cols:
        lat_col = lat_cols[0]
        lon_col = lon_cols[0]

        lat = df[lat_col].dropna()
        lon = df[lon_col].dropna()

        print(f"\n  Geographic coordinates:")
        print(f"  Latitude  range : "
              f"{lat.min():.4f} to "
              f"{lat.max():.4f}")
        print(f"  Longitude range : "
              f"{lon.min():.4f} to "
              f"{lon.max():.4f}")
        print(f"  Latitude  span  : "
              f"{(lat.max()-lat.min()):.4f} deg")
        print(f"  Longitude span  : "
              f"{(lon.max()-lon.min()):.4f} deg")

        # Unique locations
        unique_locs = (
            df[[lat_col, lon_col]]
            .dropna()
            .drop_duplicates())
        print(f"  Unique locations: "
              f"{len(unique_locs):,}")

        # Spatial resolution estimate
        if len(unique_locs) > 1:
            lat_res = np.diff(
                np.sort(unique_locs[lat_col]
                        .unique())
            ).mean() if (
                unique_locs[lat_col]
                .nunique() > 1) else np.nan
            lon_res = np.diff(
                np.sort(unique_locs[lon_col]
                        .unique())
            ).mean() if (
                unique_locs[lon_col]
                .nunique() > 1) else np.nan
            print(f"  Mean lat step   : "
                  f"{lat_res:.4f} deg")
            print(f"  Mean lon step   : "
                  f"{lon_res:.4f} deg")
    else:
        print("  No latitude/longitude columns found.")
        print(f"  Spatial columns present: "
              f"{spatial_cols}")

    # SMAP node grid (Dataset 2 specific)
    node_x_cols = [
        c for c in df.columns
        if 'node_x' in c.lower()
        or 'smap_x' in c.lower()]
    node_y_cols = [
        c for c in df.columns
        if 'node_y' in c.lower()
        or 'smap_y' in c.lower()]

    if node_x_cols and node_y_cols:
        nx = df[node_x_cols[0]].dropna()
        ny = df[node_y_cols[0]].dropna()
        print(f"\n  SMAP node grid:")
        print(f"  Node X range    : "
              f"{int(nx.min())} to "
              f"{int(nx.max())}")
        print(f"  Node Y range    : "
              f"{int(ny.min())} to "
              f"{int(ny.max())}")
        print(f"  Unique X nodes  : "
              f"{nx.nunique()}")
        print(f"  Unique Y nodes  : "
              f"{ny.nunique()}")
        unique_nodes = (
            df[[node_x_cols[0],
                node_y_cols[0]]]
            .dropna()
            .drop_duplicates())
        print(f"  Total SMAP nodes: "
              f"{len(unique_nodes):,}")

    # Site column
    site_cols = [
        c for c in df.columns
        if c.lower() == 'site'
        or 'site' in c.lower()]
    if site_cols:
        site_col = site_cols[0]
        sites = df[site_col].value_counts()
        print(f"\n  Site distribution:")
        for site, count in sites.items():
            pct = 100 * count / len(df)
            print(f"    {site:<25}: "
                  f"{count:>8,} "
                  f"({pct:.1f}%)")

    return unique_locs if (
        lat_cols and lon_cols) else None


